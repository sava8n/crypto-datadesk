# Copy before the first run:
#
#     cp .env.example .env
#
# The values below are the development defaults.

# --- postgres container ---
POSTGRES_USER=user
# embedded in DSN below, so keep it URL-safe
POSTGRES_PASSWORD=password
POSTGRES_DB=datadesk

# --- core service ---
# any DATADESK_SERVICE_* from core/config.py can go here
DATADESK_SERVICE_DB_DSN=postgresql+psycopg://user:password@db:5432/datadesk
DATADESK_SERVICE_OPENROUTER_API_KEY=

# --- dashboard container ---
# host port for the dashboard
DASHBOARD_PORT=8080

# --- backups ---
# where scripts/backup-db.sh uploads to
BACKUP_S3_URI=
