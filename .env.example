# Credentials for the compose stack.
# Copy before the first run:
#
#     cp .env.example .env
#
# The values below are the development defaults.

POSTGRES_USER=user
# password is embedded in a URL, so keep it URL-safe
# special chars would need percent-encoding in DATADESK_SERVICE_DB_DSN
POSTGRES_PASSWORD=password
POSTGRES_DB=datadesk
